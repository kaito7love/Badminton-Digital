NODE_ENV=development
PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=badminton_digital_management
# CSDL riêng cho NODE_ENV=test. KHÔNG được trùng DB_NAME — config.js sẽ chặn.
DB_NAME_TEST=badminton_digital_management_test
DB_USER=root
DB_PASSWORD=

JWT_ACCESS_SECRET=thay_bang_chuoi_ngau_nhien_rieng_cho_access_token_32ky_tu
JWT_REFRESH_SECRET=thay_bang_chuoi_ngau_nhien_rieng_cho_refresh_token_32ky_tu
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_RESET_EXPIRES=15m

# URL frontend, dùng để dựng link đặt lại mật khẩu gửi qua email
FRONTEND_URL=http://localhost:5173

# SMTP gửi mail "Quên mật khẩu" (bắt buộc để tính năng này hoạt động)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=Badminton Digital <no-reply@badminton.com>

UPLOAD_DIR=./src/uploads
