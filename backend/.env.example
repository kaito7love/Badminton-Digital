NODE_ENV=development
PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=badminton_digital_management
# CSDL riêng cho NODE_ENV=test. KHÔNG được trùng DB_NAME — config.js sẽ chặn.
DB_NAME_TEST=badminton_digital_management_test
DB_USER=root
DB_PASSWORD=

# Hai chuỗi ngẫu nhiên, KHÁC NHAU, tối thiểu 32 ký tự. Sinh mỗi chuỗi bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Server từ chối khởi động nếu thiếu, quá ngắn, hai chuỗi trùng nhau hoặc còn là chuỗi mẫu cũ.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_RESET_EXPIRES=15m

# TLS tới MySQL — bắt buộc với DB managed như Aiven. DB_SSL_CA: nội dung CA certificate
# của nhà cung cấp (PEM, hoặc base64 của PEM để dán vào một dòng). Luôn kiểm chứng chứng
# chỉ; chỉ tắt bằng DB_SSL_REJECT_UNAUTHORIZED=false (không khuyến nghị).
DB_SSL=false
DB_SSL_CA=

# URL frontend, dùng để dựng link đặt lại mật khẩu gửi qua email. Trên Render bỏ trống
# được: server tự lấy RENDER_EXTERNAL_URL.
FRONTEND_URL=http://localhost:5173

# Origin được gọi API cross-origin, phân tách bằng dấu phẩy. Bản deploy chạy cùng origin
# (backend phục vụ luôn frontend, hoặc nginx proxy /api) thì để trống: production không
# cho origin nào khác; dev mặc định http://localhost:5173.
CORS_ORIGIN=

# Số reverse proxy đứng trước Express (nginx của cụm compose, load balancer của Render...).
# Mặc định 0. Đặt sai là rate limit đăng nhập đếm sai người — kiểm bằng GET /api/v1/health:
# trường "ip" phải là IP của bạn.
TRUST_PROXY_HOPS=0

# SMTP gửi mail "Quên mật khẩu" (bắt buộc để tính năng này hoạt động)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=Badminton Digital <no-reply@badminton.com>

UPLOAD_DIR=./src/uploads

# Thanh toán chuyển khoản (mã VietQR + webhook báo tiền về). Chỉ bật khi đặt ĐỦ cả 4 biến:
# thiếu biến nào thì backend từ chối thanh toán chuyển khoản, giao diện ẩn lựa chọn này
# và POST /payments/webhook trả 503.
#   PAYMENT_BANK_ID            mã ngân hàng theo VietQR (VD: MB) hoặc BIN (VD: 970422)
#   PAYMENT_BANK_ACCOUNT_NO    số tài khoản nhận tiền của quán
#   PAYMENT_BANK_ACCOUNT_NAME  tên chủ tài khoản, viết không dấu
#   PAYMENT_WEBHOOK_SECRET     tối thiểu 32 ký tự; dịch vụ báo có gửi kèm header X-Webhook-Secret.
#                              Sinh bằng: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
PAYMENT_BANK_ID=
PAYMENT_BANK_ACCOUNT_NO=
PAYMENT_BANK_ACCOUNT_NAME=
PAYMENT_WEBHOOK_SECRET=

# Seeder dữ liệu demo tạo tài khoản mật khẩu công khai (Admin@123...), nên bị chặn
# khi NODE_ENV=production. Chỉ đặt true cho bản demo công khai.
ALLOW_DEMO_SEED=false
# Bản demo công khai: seed ở production lấy mật khẩu admin từ đây (>= 12 ký tự, không trùng
# mật khẩu demo) — repo công khai Admin@123 nên không dùng được. Máy dev bỏ trống.
DEMO_ADMIN_PASSWORD=
# Bản demo công khai: các tài khoản in trên trang đăng nhập không đổi được mật khẩu,
# SĐT hay bị xoá (người xem trước không khoá được người xem sau).
DEMO_MODE=false

# Admin đầu tiên của bản cài mới: `npm run create-admin`. Truyền các biến dưới đây
# ngay trên dòng lệnh, đừng ghi mật khẩu vào file này.
#   ADMIN_EMAIL        bắt buộc
#   ADMIN_PASSWORD     bắt buộc, tối thiểu 12 ký tự, không trùng mật khẩu demo
#   ADMIN_FULL_NAME    bắt buộc
#   ADMIN_PHONE        tuỳ chọn
#   ADMIN_BRANCH_CODE  tuỳ chọn, mặc định là chi nhánh đang hoạt động có id nhỏ nhất
