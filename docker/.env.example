# Biến cho docker compose — compose tự đọc docker/.env khi chạy trong thư mục docker/.
# Chép thành docker/.env rồi điền. KHÔNG commit docker/.env.
# Sinh mật khẩu: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"

# Mật khẩu user bp_user (backend dùng) và root của container MySQL.
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Bản demo công khai: khoá các tài khoản demo in trên trang đăng nhập, và build
# frontend có khối "Tài khoản thử nghiệm". Vận hành thật thì để false.
DEMO_MODE=false
VITE_SHOW_DEMO_ACCOUNTS=false

# Cổng trên máy host (luôn chỉ bind 127.0.0.1).
FRONTEND_HOST_PORT=8080
MYSQL_HOST_PORT=3307

# Thi đấu (competition-service): bật bằng `docker compose --profile competition up -d --build` sau khi đã chạy
# `npm run competition:keys` ở backend/ (docs/DeploymentGuide.md mục 5.2). Không cần biến nào ở file này.
