# competition-service — chép thành .env
NODE_ENV=development
HOST=127.0.0.1
PORT=5100

# DB RIÊNG của service (không bao giờ trỏ vào DB của app chính)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=competition_service
DB_USER=root
DB_PASSWORD=
# DB_SSL=true
# DB_SSL_CA=/path/to/ca.pem   (hoặc dán nội dung PEM)

# Khoá CÔNG KHAI của bên được phép ký service token (gateway app chính).
# Dev: npm run keys:generate rồi dùng dòng dưới.
TRUSTED_ISSUERS_FILE=.keys/trusted-issuers.json
# TRUSTED_ISSUERS=[{"issuer":"badminton-digital-core","jwks":{"keys":[{...}]}}]
SERVICE_AUDIENCE=competition-service

# Nhận sự kiện từ app chính (POST /v1/events), secret ≥ 32 ký tự
# INBOUND_SOURCES=[{"source":"badminton-digital-core","secret":"...","tenant":"badminton-digital"}]

# Gửi sự kiện đi (webhook ký HMAC), secret ≥ 32 ký tự
# WEBHOOK_TARGETS=[{"name":"core","url":"http://localhost:5000/api/v1/integrations/competition/events","secret":"...","types":["competition.*"]}]
# OUTBOX_POLL_MS=5000

# Luồng SSE của màn hình TV (GET /v1/sessions/{id}/stream): gửi `ping` mỗi chừng này ms
# SSE_HEARTBEAT_MS=25000

# Ảnh chụp BXH hằng ngày: 03:00 theo UTC+7
# SNAPSHOT_HOUR=3
# SNAPSHOT_UTC_OFFSET_MINUTES=420

# DOCS_ENABLED=true            (Swagger UI ở /docs — mặc định tắt ở production)
# LOG_LEVEL=info
