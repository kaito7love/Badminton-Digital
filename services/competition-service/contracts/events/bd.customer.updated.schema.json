{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "bd.customer.updated/v1",
  "title": "(Nhận vào) App chính: khách hàng đổi thông tin",
  "type": "object",
  "required": ["externalRef", "fullName"],
  "properties": {
    "externalRef": { "type": "string" },
