{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "competition.session.closed/v1",
  "title": "Buổi giao lưu đã đóng — số trận có tỉ số, điểm trình thay đổi (nếu buổi bật tính điểm)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sessionId",
    "organizerRef",
    "rated",
    "matches",
    "ratingChanges"
  ],
  "properties": {
    "sessionId": {
      "type": "string",
      "format": "uuid"
    },
    "organizerRef": {
      "type": "string"
    },
    "rated": {
      "type": "boolean"
    },
    "matches": {
      "type": "integer",
      "minimum": 0,
      "description": "Số trận có tỉ số (trận chưa có tỉ số bị huỷ khi đóng buổi)"
    },
    "ratingChanges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "playerId",
          "discipline",
          "before",
          "after"
        ],
        "properties": {
          "playerId": {
            "type": "string",
            "format": "uuid"
          },
          "discipline": {
            "enum": [
              "singles",
              "doubles"
            ]
          },
          "before": {
            "type": "number"
          },
          "after": {
            "type": "number"
          }
        }
      }
    }
  }
}
