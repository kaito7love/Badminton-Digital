{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "competition.tournament.finalized/v1",
  "title": "Giải đã chốt — thứ hạng, điểm trình, điểm BXH thành tích",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tournamentId",
    "organizerRef",
    "placements",
    "ratingChanges",
    "rankingPoints"
  ],
  "properties": {
    "tournamentId": {
      "type": "string",
      "format": "uuid"
    },
    "organizerRef": {
      "type": "string"
    },
    "placements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "teamId",
          "from",
          "to",
          "label",
          "players"
        ],
        "properties": {
          "teamId": {
            "type": "string",
            "format": "uuid"
          },
          "from": {
            "type": "integer"
          },
          "to": {
            "type": "integer"
          },
          "label": {
            "type": "string"
          },
          "players": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      }
    },
    "ratingChanges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "playerId",
          "discipline",
          "before",
          "after"
        ],
        "properties": {
          "playerId": {
            "type": "string",
            "format": "uuid"
          },
          "discipline": {
            "enum": [
              "singles",
              "doubles"
            ]
          },
          "before": {
            "type": "number"
          },
          "after": {
            "type": "number"
          }
        }
      }
    },
    "rankingPoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "playerId",
          "category",
          "points"
        ],
        "properties": {
          "playerId": {
            "type": "string",
            "format": "uuid"
          },
          "category": {
            "enum": [
              "MS",
              "WS",
              "MD",
              "WD",
              "XD"
            ]
          },
          "points": {
            "type": "integer"
          }
        }
      }
    }
  }
}
