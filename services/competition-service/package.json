{
  "name": "competition-service",
  "version": "0.5.0",
  "private": true,
  "description": "Dịch vụ Thi đấu: chấm trình, điểm trình, xếp hạng, xếp cặp, giải đấu, giao lưu — service độc lập của Badminton Digital",
  "main": "src/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/main.js",
    "dev": "nodemon --watch src --watch openapi --watch contracts src/main.js",
    "test": "jest --runInBand",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "keys:generate": "node scripts/keys-generate.js",
    "token:dev": "node scripts/token-dev.js",
    "check-boundaries": "node scripts/check-boundaries.js",
    "snapshot": "node scripts/snapshot.js",
    "seed:demo": "node scripts/seed-demo.js",
    "sim:session": "node scripts/sim-session.js"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-openapi-validator": "^5.6.2",
    "jose": "^5.10.0",
    "js-yaml": "^4.3.2",
    "mysql2": "^3.24.4",
    "pino": "^9.14.0",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.0"
  }
}
